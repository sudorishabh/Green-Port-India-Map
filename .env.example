# Copy to .env and fill in real values. Never commit .env.

# --- Map (public, exposed to the browser) ---
# Optional: CARTO's Voyager street tiles (free key from carto.com/basemaps).
# Left blank, the map uses OpenStreetMap's own tiles.
NEXT_PUBLIC_CARTO_KEY=

# --- Database (server only) ---
DATABASE_URL=postgres://user:password@localhost:5432/india_trade_network

# --- Auth (server only): long random strings, different from each other ---
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
