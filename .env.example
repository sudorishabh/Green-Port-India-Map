# Copy to .env and fill in real values. Never commit .env.

# --- Map (public, exposed to the browser) ---
NEXT_PUBLIC_GOOGLE_MAP_API=
NEXT_PUBLIC_MAP_ID=

# --- Database (server only) ---
DATABASE_URL=postgres://user:password@localhost:5432/india_trade_network

# --- Auth (server only): long random strings, different from each other ---
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
