# Copy to .env and fill in real values. Never commit .env.

# --- Map (public, exposed to the browser) ---
NEXT_PUBLIC_GOOGLE_MAP_API=
NEXT_PUBLIC_MAP_ID=
NEXT_PUBLIC_BASE_URL=http://localhost:5070

# --- Database (server only) ---
DATABASE_URL=postgres://user:password@localhost:5432/india_trade_network

# --- Auth (server only): long random strings, different from each other ---
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# --- S3 (server only) ---
APP_AWS_REGION=ap-south-1
APP_AWS_S3_BUCKET_NAME=
# Optional: omit both to use the default AWS credential chain (e.g. an IAM role).
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
